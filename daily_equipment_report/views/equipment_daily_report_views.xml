<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_equipment_daily_report_form" model="ir.ui.view">
        <field name="name">equipment.daily.report.form</field>
        <field name="model">equipment.daily.report</field>
        <field name="arch" type="xml">
            <form string="Daily Equipment Inspection">

                <header>
                    <button name="action_submit"
                            type="object"
                            string="Submit"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="%(action_report_equipment_daily_inspection)d"
                            type="action"
                            string="Print"
                            class="btn-secondary"
                            icon="fa-print"/>

                    <button name="action_approve"
                            type="object"
                            string="Approve"
                            class="btn-primary"
                            groups="daily_equipment_report.group_equipment_manager"
                            invisible="state != 'submitted'"/>

                    <button name="action_set_equipment_out_of_service"
                            type="object"
                            string="Out of Service"
                            class="btn-secondary"
                            groups="daily_equipment_report.group_equipment_manager"
                            invisible="state != 'submitted' or not has_issue"/>

                    <button name="action_close"
                            type="object"
                            string="Close"
                            class="btn-secondary"
                            groups="daily_equipment_report.group_equipment_manager"
                            invisible="state != 'approved'"/>

                    <button name="action_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            groups="daily_equipment_report.group_equipment_manager"
                            invisible="state == 'draft'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,closed"/>
                </header>

                <sheet>
                    <widget name="web_ribbon"
                            text="Critical Issue"
                            bg_color="text-bg-danger"
                            invisible="not has_critical_issue"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Equipment">
                            <field name="equipment_id"
                                   domain="[('active', '=', True)]"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="category_id" readonly="1"/>
                            <field name="equipment_operational_status" readonly="1"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"
                                   readonly="1"/>
                        </group>

                        <group string="Inspection Information">
                            <field name="user_id" readonly="1"/>
                            <field name="report_date" readonly="1"/>
                            <field name="has_issue" readonly="1"/>
                            <field name="has_critical_issue" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Inspection Checklist" name="inspection_checklist">
                            <div class="alert alert-info"
                                 role="alert"
                                 invisible="equipment_id">
                                Select equipment to load the checklist configured for its category.
                            </div>

                            <div class="alert alert-warning"
                                 role="alert"
                                 invisible="state != 'draft' or not has_issue">
                                Failed checks require both a photo and a description before submission.
                            </div>

                            <field name="line_ids"
                                   nolabel="1"
                                   readonly="state != 'draft'">
                                <list editable="bottom"
                                      create="false"
                                      delete="false"
                                      default_order="sequence, id"
                                      decoration-danger="answer == 'no' and failure_severity == 'critical'"
                                      decoration-warning="answer == 'no' and failure_severity != 'critical'">
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="question_id" readonly="1"/>
                                    <field name="failure_severity"
                                           widget="badge"
                                           readonly="1"
                                           decoration-info="failure_severity == 'low'"
                                           decoration-warning="failure_severity == 'medium'"
                                           decoration-primary="failure_severity == 'high'"
                                           decoration-danger="failure_severity == 'critical'"/>
                                    <field name="answer"
                                           widget="radio"
                                           options="{'horizontal': true}"/>
                                    <field name="issue_image"
                                           widget="image"
                                           invisible="answer != 'no'"/>
                                    <field name="issue_description"
                                           invisible="answer != 'no'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Approval" name="approval_information">
                            <group>
                                <group string="Submission">
                                    <field name="submitted_date" readonly="1"/>
                                </group>
                                <group string="Approval and Closure">
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_date" readonly="1"/>
                                    <field name="closed_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_equipment_daily_report_list" model="ir.ui.view">
        <field name="name">equipment.daily.report.list</field>
        <field name="model">equipment.daily.report</field>
        <field name="arch" type="xml">
            <list default_order="report_date desc, id desc"
                  decoration-danger="has_critical_issue"
                  decoration-warning="has_issue and not has_critical_issue">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="category_id"/>
                <field name="user_id"/>
                <field name="report_date"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-muted="state == 'closed'"/>
                <field name="has_issue" optional="show"/>
                <field name="has_critical_issue" optional="show"/>
                <field name="approved_by_id" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_equipment_daily_report_search" model="ir.ui.view">
        <field name="name">equipment.daily.report.search</field>
        <field name="model">equipment.daily.report</field>
        <field name="arch" type="xml">
            <search string="Daily Equipment Inspections">
                <field name="name"/>
                <field name="equipment_id"/>
                <field name="category_id"/>
                <field name="user_id"/>
                <field name="approved_by_id"/>

                <separator/>

                <filter string="Draft" name="state_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="state_submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="state_approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Closed" name="state_closed" domain="[('state', '=', 'closed')]"/>

                <separator/>

                <filter string="With Issues"
                        name="with_issues"
                        domain="[('has_issue', '=', True)]"/>
                <filter string="Critical Issues"
                        name="critical_issues"
                        domain="[('has_critical_issue', '=', True)]"/>
                <filter string="Without Issues"
                        name="without_issues"
                        domain="[('has_issue', '=', False)]"/>
                <filter name="report_date_filter" date="report_date"/>

                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                    <filter string="Equipment" name="group_equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter string="Inspected By" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Approved By" name="group_approver" context="{'group_by': 'approved_by_id'}"/>
                    <filter string="Inspection Date" name="group_report_date" context="{'group_by': 'report_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_equipment_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Inspections</field>
        <field name="res_model">equipment.daily.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_equipment_daily_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first equipment inspection</p>
            <p>Select equipment, complete its checklist, and submit it for approval.</p>
        </field>
    </record>

</odoo>
