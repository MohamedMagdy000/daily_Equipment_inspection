<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_equipment_inspection"
            model="ir.module.category">
        <field name="name">Equipment Inspections</field>
        <field name="description">
            Equipment inspection and maintenance access
        </field>
        <field name="sequence">35</field>
    </record>

    <record id="res_groups_privilege_equipment_inspection"
            model="res.groups.privilege">
        <field name="name">Equipment Inspections</field>
        <field name="category_id"
               ref="module_category_equipment_inspection"/>
    </record>

    <record id="group_equipment_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id"
               ref="res_groups_privilege_equipment_inspection"/>
    </record>

    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id"
               ref="res_groups_privilege_equipment_inspection"/>
        <field name="implied_ids"
               eval="[(4, ref('group_equipment_user'))]"/>
    </record>

    <record id="rule_maintenance_equipment_allowed_categories"
            model="ir.access">
        <field name="name">Equipment: category-based access</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="group_id" ref="group_equipment_user"/>
        <field name="operation">ru</field>
        <field name="domain">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('category_id', 'in', user.allowed_equipment_category_ids.ids)]</field>
    </record>

    <record id="rule_maintenance_equipment_manager_all"
            model="ir.access">
        <field name="name">Equipment: manager unrestricted access</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="group_id" ref="group_equipment_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="rule_equipment_category_user_allowed"
            model="ir.access">
        <field name="name">Equipment Categories: category-based access</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment_category"/>
        <field name="group_id" ref="group_equipment_user"/>
        <field name="operation">r</field>
        <field name="domain">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('id', 'in', user.allowed_equipment_category_ids.ids)]</field>
    </record>

    <record id="rule_equipment_category_manager_all" model="ir.access">
        <field name="name">Equipment Categories: manager unrestricted access</field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment_category"/>
        <field name="group_id" ref="group_equipment_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="rule_checklist_question_user_categories"
            model="ir.access">
        <field name="name">Checklist Questions: category-based access</field>
        <field name="model_id" ref="model_equipment_checklist_question"/>
        <field name="group_id" ref="group_equipment_user"/>
        <field name="operation">r</field>
        <field name="domain">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('category_id', 'in', user.allowed_equipment_category_ids.ids)]</field>
    </record>

    <record id="rule_checklist_question_manager_all" model="ir.access">
        <field name="name">Checklist Questions: manager unrestricted access</field>
        <field name="model_id" ref="model_equipment_checklist_question"/>
        <field name="group_id" ref="group_equipment_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="rule_daily_report_user_categories" model="ir.access">
        <field name="name">Daily Inspections: category-based access</field>
        <field name="model_id" ref="model_equipment_daily_report"/>
        <field name="group_id" ref="group_equipment_user"/>
        <field name="operation">cru</field>
        <field name="domain">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('category_id', 'in', user.allowed_equipment_category_ids.ids)]</field>
    </record>

    <record id="rule_daily_report_manager_all" model="ir.access">
        <field name="name">Daily Inspections: manager unrestricted access</field>
        <field name="model_id" ref="model_equipment_daily_report"/>
        <field name="group_id" ref="group_equipment_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="rule_daily_report_line_user_categories"
            model="ir.access">
        <field name="name">Inspection Lines: category-based access</field>
        <field name="model_id" ref="model_equipment_daily_report_line"/>
        <field name="group_id" ref="group_equipment_user"/>
        <field name="operation">cru</field>
        <field name="domain">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('report_id.category_id', 'in', user.allowed_equipment_category_ids.ids)]</field>
    </record>

    <record id="rule_daily_report_line_manager_all" model="ir.access">
        <field name="name">Inspection Lines: manager unrestricted access</field>
        <field name="model_id" ref="model_equipment_daily_report_line"/>
        <field name="group_id" ref="group_equipment_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>

    <record id="rule_spare_part_user_categories" model="ir.access">
        <field name="name">Spare Parts: category-based access</field>
        <field name="model_id" ref="model_equipment_spare_part"/>
        <field name="group_id" ref="group_equipment_user"/>
        <field name="operation">ru</field>
        <field name="domain">[(1, '=', 1)] if not user.allowed_equipment_category_ids else [('equipment_id.category_id', 'in', user.allowed_equipment_category_ids.ids)]</field>
    </record>

    <record id="rule_spare_part_manager_all" model="ir.access">
        <field name="name">Spare Parts: manager unrestricted access</field>
        <field name="model_id" ref="model_equipment_spare_part"/>
        <field name="group_id" ref="group_equipment_manager"/>
        <field name="operation">crud</field>
        <field name="domain">[(1, '=', 1)]</field>
    </record>
</odoo>
